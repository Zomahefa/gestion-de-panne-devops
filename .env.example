# Copier ce fichier vers .env et remplir les valeurs.
# Ne jamais committer le fichier .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-with-a-long-random-value
DEBUG=0
DJANGO_ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
DJANGO_ENV=prod

# --- Base de données Neon (Render) ---
# Exemple : postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Doit rester < 300 (Neon met le compute en veille après 5 min d'inactivité)
DB_CONN_MAX_AGE=60

# --- Stockage des images (Cloudinary) ---
# Exemple : cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=https://signaleo.onrender.com
CSRF_TRUSTED_ORIGINS=https://signaleo-api.onrender.com

# --- Données de démonstration ---
SEED_DEMO=1
DEMO_ADMIN_USERNAME=demo.admin
DEMO_ADMIN_PASSWORD=DemoAdmin!2026
DEMO_TECH_USERNAME=demo.tech
DEMO_TECH_PASSWORD=DemoTech!2026
DEMO_SUPERUSER_USERNAME=demo.super
DEMO_SUPERUSER_PASSWORD=DemoSuper!2026

# --- Compte administrateur de reference (creation unique en base) ---
# Recommande : lancer `python manage.py create_admin` avec DATABASE_URL
# pointe sur Neon. Sur Render gratuit il n'y a pas de shell : activer
# BOOTSTRAP_ADMIN=1 + ADMIN_PASSWORD + ADMIN_EMAIL le temps d'un deploy,
# puis remettre BOOTSTRAP_ADMIN=0. La commande est idempotente.
BOOTSTRAP_ADMIN=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_FULL_NAME=
ADMIN_MATRICULE=
ADMIN_CONTACT=
ADMIN_ROLE=admin
# 1 = reinitialise le mot de passe du compte existant au prochain deploy
ADMIN_RESET_PASSWORD=0

# --- Inscription administrateur (demonstration portfolio) ---
# 0 = ferme completement la page /admin-register
ADMIN_REGISTRATION_ENABLED=1
# Code remis sur demande par le developpeur.
# Aucun code par defaut : si la variable est absente ou vide, la page est
# fermee. Ne jamais committer ce code dans le depot.
ADMIN_REGISTRATION_CODE=

# --- Limitation de debit (cache des compteurs) ---
# Repertoire partage par les workers gunicorn. /tmp convient sur Render.
THROTTLE_CACHE_DIR=/tmp/signaleo-cache

# --- Gunicorn ---
WEB_CONCURRENCY=2

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# 📦 Dépendances
/node_modules
/.pnp
.pnp.js

# 🧪 Tests
/coverage

# 🏗️ Build
/build
/dist

# 🔐 Variables d’environnement
.env.local
.env.development.local
.env.test.local
.env.production.local

# 🧪 Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 🗂️ Fichiers système
.DS_Store
*.swp

# 🧠 Pourquoi ?
# - node_modules : trop volumineux, recréé avec npm install
# - build/dist : générés automatiquement
# - .env.* : contient des URLs, clés API
# - logs : inutiles pour le repo
# - .DS_Store, *.swp : fichiers système
